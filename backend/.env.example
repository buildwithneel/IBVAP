# ==============================================================================
# IBVAP Backend Environment Configuration Template (.env.example)
# Copy this file to backend/.env and configure your local/production settings.
# NEVER commit the real .env file with secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Service & Security Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="IBVAP Backend Service"
API_V1_STR="/api/v1"

# Cryptographic Secret Key for JWT token signing (Generate a secure random key for production)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM="HS256"

# ------------------------------------------------------------------------------
# Database Connection
# ------------------------------------------------------------------------------
# SQLite (default for local development)
DATABASE_URL="sqlite:///./ibvap.db"
# PostgreSQL (production recommended)
# DATABASE_URL="postgresql://ibvap_user:your_password@localhost:5432/ibvap_db"

# ------------------------------------------------------------------------------
# AI Computer Vision & Inference Settings
# ------------------------------------------------------------------------------
YOLO_MODEL_PATH="models/yolov8n.pt"
YOLO_CONFIDENCE_THRESHOLD=0.22
YOLO_TWO_WHEELER_CONFIDENCE_THRESHOLD=0.12
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE="cpu" # Use "0" or "cuda" for GPU acceleration
TRACKER_MAX_COAST_FRAMES=15
DEBUG_OVERLAY=true

# ------------------------------------------------------------------------------
# Surveillance Business Rules
# ------------------------------------------------------------------------------
ZONE_CONFIRMATION_FRAMES=3
TRACK_STATE_TTL_SECONDS=3.0
LOITERING_THRESHOLD_SECONDS=10.0
EVENT_COOLDOWN_SECONDS=8.0
NIGHT_START_TIME="20:00"
NIGHT_END_TIME="06:00"
TIMEZONE="UTC"
LOW_LIGHT_THRESHOLD=80.0
LOW_LIGHT_CONFIRMATION_FRAMES=5

# ------------------------------------------------------------------------------
# Deduplication & False Alert Suppression Settings
# ------------------------------------------------------------------------------
VEHICLE_EVENT_GROUPING_WINDOW_SECONDS=12.0
VEHICLE_EVENT_COOLDOWN_SECONDS=10.0
UNUSUAL_MOVEMENT_SPEED_THRESHOLD_PX_SEC=380.0
UNUSUAL_MOVEMENT_PERSISTENCE_FRAMES=6
UNUSUAL_MOVEMENT_MIN_CONFIDENCE=0.45
MOTION_ALERT_MIN_CONFIDENCE=0.40
MOTION_ALERT_PERSISTENCE_FRAMES=5

# ------------------------------------------------------------------------------
# Evidence & Upload Storage
# ------------------------------------------------------------------------------
STORAGE_DIR="storage"

# ------------------------------------------------------------------------------
# Development & Testing Modules
# ------------------------------------------------------------------------------
ENABLE_LOCAL_CAMERA_TESTING=false
